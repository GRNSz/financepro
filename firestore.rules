rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras de segurança para a coleção de usuários
    // Cada usuário autenticado só pode ler e escrever em seus próprios dados (isolamento de tenant)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Regra recursiva para subcoleções dentro do documento do usuário
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Ponte temporária de autenticação para o aplicativo desktop (Tauri)
    match /login_sessions/{sessionId} {
      allow read, create, delete: if true;
    }
  }
}
