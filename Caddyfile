{$SITE_DOMAIN:localhost} {
    # Compactação automática de arquivos
    encode gzip zstd

    # Diretório raiz para servir os arquivos estáticos compilados do frontend
    root * /usr/share/caddy

    # Habilita o servidor de arquivos estáticos para a pasta assets (retorna 404 se não encontrado)
    handle /assets/* {
        file_server
    }

    # Suporte a roteamento SPA (Single Page Application) para outras rotas
    handle {
        try_files {path} {path}/ /index.html
        file_server
    }

    # Cabeçalhos de segurança HTTP recomendados e CSP restritivo
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' cdn.jsdelivr.net cdnjs.cloudflare.com www.gstatic.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src 'self' fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://generativelanguage.googleapis.com https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com; frame-src 'self' link.mercadopago.com.br;"
    }
}
